FROM emscripten/emsdk:3.1.50

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y \
    git \
    build-essential \
    ninja-build \
    pkg-config \
    python3 \
    python3-pip \
    python3-setuptools \
    python3-wheel \
    ca-certificates \
    curl \
    xz-utils \
    bzip2 \
    unzip \
    && rm -rf /var/lib/apt/lists/*

RUN python3 -m pip install --no-cache-dir \
    "meson==1.4.2" \
    "tomli"

RUN meson --version && emcc --version

WORKDIR /build

RUN mkdir -p \
    /build/output/qemu \
    /build/sysroot \
    /build/glib-src \
    /build/glib-build \
    /build/qemu-src \
    /build/qemu-build

# ------------------------------------------------------------
# GLIB
# ------------------------------------------------------------

RUN git clone \
    --depth 1 \
    --branch 2.76.6 \
    https://github.com/GNOME/glib.git \
    /build/glib-src

WORKDIR /build/glib-src

# Tell Meson that Emscripten is the host.
RUN cat > /build/glib-cross.txt <<'EOF'
[binaries]
c = 'emcc'
cpp = 'em++'
ar = 'emar'
strip = 'emstrip'
ranlib = 'emranlib'
pkg-config = '/usr/bin/false'

[host_machine]
system = 'emscripten'
cpu_family = 'wasm32'
cpu = 'wasm32'
endian = 'little'

[properties]
needs_exe_wrapper = true
has_function_printf = true
EOF

RUN meson subprojects download

# ------------------------------------------------------------
# PATCH GLIB'S BUNDLED LIBFFI
#
# GLib 2.76.6's bundled libffi does not recognize
# Emscripten/wasm32 correctly.  We patch its Meson file so
# it uses the generic wasm configuration.
# ------------------------------------------------------------

RUN python3 - <<'PY'
from pathlib import Path

p = Path("/build/glib-src/subprojects/libffi/meson.build")
s = p.read_text()

old = '''if host_system == 'emscripten'
  if host_cpu_family == 'wasm32'
    error('Unsupported pair: system "emscripten", cpu family "wasm32"')
  endif
endif
'''

if old in s:
    s = s.replace(old, '')

p.write_text(s)
PY

# ------------------------------------------------------------
# BUILD GLIB
# ------------------------------------------------------------

RUN rm -rf /build/glib-build && \
    meson setup /build/glib-build \
      --cross-file /build/glib-cross.txt \
      --prefix=/build/sysroot \
      --libdir=lib \
      -Dtests=false \
      -Dinstalled_tests=false \
      -Dman=false \
      -Dbsymbolic_functions=false \
      -Dglib_debug=disabled \
      -Dforce_posix_threads=true \
      -Dlibmount=disabled \
      -Dselinux=disabled \
      -Dxattr=false \
      -Dlibelf=disabled

RUN ninja -C /build/glib-build

RUN ninja -C /build/glib-build install

# ------------------------------------------------------------
# QEMU
# ------------------------------------------------------------

WORKDIR /build

RUN git clone \
    --depth 1 \
    --branch v9.2.0 \
    https://gitlab.com/qemu-project/qemu.git \
    /build/qemu-src

WORKDIR /build/qemu-src

# ------------------------------------------------------------
# QEMU CONFIGURATION
# ------------------------------------------------------------

RUN ./configure \
    --static \
    --target-list=x86_64-softmmu \
    --cpu=wasm32 \
    --disable-system \
    --enable-system \
    --disable-user \
    --disable-linux-user \
    --disable-bsd-user \
    --disable-docs \
    --disable-tools \
    --disable-plugins \
    --disable-debug-info \
    --disable-werror \
    --disable-gtk \
    --disable-sdl \
    --disable-opengl \
    --disable-vte \
    --disable-curses \
    --disable-spice \
    --disable-vnc \
    --disable-slirp \
    --disable-libssh \
    --disable-libnfs \
    --disable-libiscsi \
    --disable-libusb \
    --disable-usb-redir \
    --disable-virglrenderer \
    --disable-cap-ng \
    --disable-seccomp \
    --disable-libcap-ng \
    --disable-pie \
    --disable-fdt \
    --disable-zstd \
    --disable-bzip2 \
    --disable-lzo \
    --disable-snappy \
    --disable-coroutine-pool \
    --disable-coroutine-tsan \
    --disable-kvm \
    --disable-hvf \
    --disable-whpx \
    --disable-tcg-interpreter \
    --enable-tcg \
    --enable-fdt=internal \
    --with-sysroot=/build/sysroot

# ------------------------------------------------------------
# BUILD QEMU-WASM
# ------------------------------------------------------------

RUN emconfigure ./configure \
    --static \
    --target-list=x86_64-softmmu \
    --cpu=wasm32 \
    --disable-docs \
    --disable-tools \
    --disable-plugins \
    --disable-debug-info \
    --disable-werror \
    --disable-gtk \
    --disable-sdl \
    --disable-opengl \
    --disable-vte \
    --disable-curses \
    --disable-spice \
    --disable-vnc \
    --disable-slirp \
    --disable-libssh \
    --disable-libnfs \
    --disable-libiscsi \
    --disable-libusb \
    --disable-usb-redir \
    --disable-virglrenderer \
    --disable-cap-ng \
    --disable-seccomp \
    --disable-libcap-ng \
    --disable-pie \
    --disable-kvm \
    --disable-hvf \
    --disable-whpx \
    --disable-tcg-interpreter \
    --enable-tcg \
    --enable-fdt=internal \
    --with-sysroot=/build/sysroot

RUN emmake ninja -C build

# ------------------------------------------------------------
# COPY OUTPUT
# ------------------------------------------------------------

RUN mkdir -p /build/output/qemu && \
    find /build/qemu-src/build \
      -type f \
      \( -name 'qemu-system-x86_64' \
      -o -name '*.wasm' \
      -o -name '*.js' \
      -o -name '*.worker.js' \) \
      -exec cp -v {} /build/output/qemu/ \;

# ------------------------------------------------------------
# FINAL OUTPUT
# ------------------------------------------------------------

WORKDIR /build/output

RUN echo "========================================" && \
    echo " QEMU-WASM BUILD COMPLETE" && \
    echo "========================================" && \
    find /build/output/qemu -maxdepth 1 -type f -print

CMD ["bash"]
