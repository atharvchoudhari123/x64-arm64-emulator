FROM emscripten/emsdk:3.1.50

ENV DEBIAN_FRONTEND=noninteractive

# ============================================================
# BUILD DEPENDENCIES
# ============================================================

RUN apt-get update && apt-get install -y \
    git \
    build-essential \
    ninja-build \
    pkg-config \
    python3 \
    python3-pip \
    python3-setuptools \
    python3-wheel \
    gettext \
    libglib2.0-dev \
    libpixman-1-dev \
    libslirp-dev \
    libfdt-dev \
    && rm -rf /var/lib/apt/lists/*

# Use a known-compatible Meson version.
RUN python3 -m pip install --no-cache-dir \
    "meson==1.4.2" \
    "tomli"

RUN meson --version && emcc --version

# ============================================================
# DIRECTORIES
# ============================================================

WORKDIR /build

RUN mkdir -p \
    /build/output/qemu \
    /build/sysroot \
    /build/glib-src \
    /build/glib-build \
    /build/qemu-src \
    /build/qemu-build

# ============================================================
# GLIB
# ============================================================

RUN git clone \
    --depth 1 \
    --branch 2.76.6 \
    https://github.com/GNOME/glib.git \
    /build/glib-src

WORKDIR /build/glib-src

# Download GLib subprojects.
RUN meson subprojects download

# Remove libffi fallback because the bundled libffi version
# does not support the Emscripten/wasm32 combination used here.
RUN rm -rf \
    subprojects/libffi \
    subprojects/libffi-* \
    subprojects/libffi-*

# ============================================================
# GLIB CROSS FILE
# ============================================================

RUN cat > /build/glib-cross.txt <<'EOF'
[binaries]
c = 'emcc'
cpp = 'em++'
ar = 'emar'
strip = 'emstrip'
ranlib = 'emranlib'
pkg-config = '/usr/bin/false'

[host_machine]
system = 'emscripten'
cpu_family = 'wasm32'
cpu = 'wasm32'
endian = 'little'

[properties]
needs_exe_wrapper = true
skip_sanity_check = true
EOF

# ============================================================
# PATCH GLIB FOR EMSCRIPTEN
# ============================================================

# Prevent GLib from requiring libffi.
RUN python3 - <<'PY'
from pathlib import Path

p = Path("/build/glib-src/meson.build")
s = p.read_text()

old = "dependency('libffi',"
new = "dependency('libffi', required: false,"

if old in s:
    s = s.replace(old, new)

p.write_text(s)
PY

# ------------------------------------------------------------
# GLib's GIO build checks for the native res_query()
# resolver API. Emscripten/WebAssembly does not provide
# that native API, because networking is handled by the
# browser environment.
#
# Skip this native-only check during cross compilation.
# ------------------------------------------------------------

RUN python3 - <<'PY'
from pathlib import Path

p = Path("/build/glib-src/gio/meson.build")
s = p.read_text()

old = """if not cc.has_function('res_query',
    prefix: '#include <resolv.h>')
  error('Could not find res_query()')
endif
"""

new = """if not meson.is_cross_build() and not cc.has_function('res_query',
    prefix: '#include <resolv.h>')
  error('Could not find res_query()')
endif
"""

if old not in s:
    raise SystemExit(
        "ERROR: Could not find the expected res_query() block in gio/meson.build"
    )

p.write_text(s.replace(old, new))
PY

# ============================================================
# CONFIGURE GLIB
# ============================================================

RUN rm -rf /build/glib-build && \
    meson setup /build/glib-build \
      --cross-file /build/glib-cross.txt \
      --prefix=/build/sysroot \
      --libdir=lib \
      -Dtests=false \
      -Dinstalled_tests=false \
      -Dman=false \
      -Dbsymbolic_functions=false \
      -Dglib_debug=disabled \
      -Dforce_posix_threads=true \
      -Dlibmount=disabled \
      -Dselinux=disabled \
      -Dxattr=false \
      -Dlibelf=disabled \
      -Dsystemtap=false

# ============================================================
# BUILD GLIB
# ============================================================

RUN meson compile -C /build/glib-build

# ============================================================
# INSTALL GLIB
# ============================================================

RUN meson install -C /build/glib-build

# ============================================================
# QEMU
# ============================================================

WORKDIR /build

RUN git clone \
    --depth 1 \
    --branch v9.2.0 \
    https://gitlab.com/qemu-project/qemu.git \
    /build/qemu-src

WORKDIR /build/qemu-src

# Initialize QEMU submodules.
RUN git submodule update --init --recursive

# ============================================================
# QEMU BUILD DIRECTORY
# ============================================================

RUN mkdir -p /build/qemu-build

# ============================================================
# QEMU CONFIGURE
# ============================================================

RUN /build/qemu-src/configure \
    --static \
    --target-list=x86_64-softmmu \
    --cpu=wasm32 \
    --cc=emcc \
    --cxx=em++ \
    --ar=emar \
    --ranlib=emranlib \
    --strip=emstrip \
    --prefix=/build/output/qemu \
    --disable-werror \
    --disable-docs \
    --disable-gtk \
    --disable-sdl \
    --disable-vnc \
    --disable-curl \
    --disable-libssh \
    --disable-opengl \
    --disable-pie \
    --disable-slirp \
    --disable-capstone \
    --disable-fdt \
    --disable-bzip2 \
    --disable-lzo \
    --disable-snappy \
    --disable-seccomp \
    --disable-xen \
    --disable-kvm \
    --disable-hvf \
    --disable-whpx \
    --disable-netmap \
    --disable-vde \
    --disable-brlapi \
    --disable-usb-redir \
    --disable-libusb \
    --disable-spice \
    --disable-rdma \
    --disable-png \
    --disable-vte \
    --disable-virglrenderer \
    --disable-libiscsi \
    --disable-libnfs \
    --disable-libpmem \
    --disable-libdaxctl \
    --disable-libudev \
    --disable-bpf \
    --disable-bpf-syscall \
    --disable-fuse \
    --disable-fuse-lseek \
    --disable-numa \
    --disable-linux-aio \
    --disable-linux-io-uring \
    --disable-io-uring \
    --disable-libdw \
    --disable-libcap-ng \
    --disable-keyring \
    --disable-gnutls \
    --disable-nettle \
    --disable-auth-pam \
    --disable-rbd \
    --disable-pvrdma \
    --disable-coroutine-pool \
    --disable-membarrier \
    --disable-fdt \
    --enable-tcg \
    --enable-system

# ============================================================
# BUILD QEMU
# ============================================================

RUN emmake make -j2

# ============================================================
# INSTALL QEMU
# ============================================================

RUN emmake make install

# ============================================================
# WEBASSEMBLY LINK
# ============================================================

WORKDIR /build/output/qemu

RUN if [ -f qemu-system-x86_64 ]; then \
      emcc \
        qemu-system-x86_64 \
        -o qemu-system-x86_64.html \
        -sWASM_BIGINT \
        -sALLOW_MEMORY_GROWTH=1 \
        -sINITIAL_MEMORY=512MB \
        -sMAXIMUM_MEMORY=2300MB \
        -sSTACK_SIZE=8MB \
        -sMODULARIZE=1 \
        -sEXPORT_ES6=1 \
        -sENVIRONMENT=web,worker \
        -sFORCE_FILESYSTEM=1 \
        -sEXIT_RUNTIME=0 \
        -sASSERTIONS=1 \
        -sNO_EXIT_RUNTIME=1 \
        -sPTHREAD_POOL_SIZE=4 \
        -sPROXY_TO_PTHREAD=1 \
        -O2; \
    fi

# ============================================================
# VERIFY
# ============================================================

RUN echo "========================================" && \
    echo " QEMU-WASM BUILD OUTPUT" && \
    echo "========================================" && \
    find /build/output/qemu -maxdepth 2 -type f -print && \
    echo "========================================"

# ============================================================
# DEFAULT CONTAINER COMMAND
# ============================================================

CMD ["bash"]