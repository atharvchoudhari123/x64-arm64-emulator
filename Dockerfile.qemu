FROM emscripten/emsdk:3.1.50

ENV DEBIAN_FRONTEND=noninteractive

# ============================================================
# Browser VM - QEMU-Wasm Builder
# ============================================================

RUN apt-get update && apt-get install -y \
    git \
    build-essential \
    ninja-build \
    pkg-config \
    python3 \
    python3-pip \
    python3-setuptools \
    python3-wheel \
    curl \
    wget \
    xz-utils \
    bzip2 \
    unzip \
    ca-certificates \
    file \
    rsync \
    libffi-dev \
    && rm -rf /var/lib/apt/lists/*

# ============================================================
# Meson
# ============================================================

RUN python3 -m pip install --no-cache-dir \
    "meson==1.4.2" \
    "tomli"

RUN meson --version

# ============================================================
# Directories
# ============================================================

WORKDIR /build

RUN mkdir -p \
    /build/output/qemu \
    /build/sysroot \
    /build/glib-src \
    /build/glib-build \
    /build/qemu-src \
    /build/qemu-build

# ============================================================
# GLib 2.76.6
# ============================================================

RUN git clone \
    --depth 1 \
    --branch 2.76.6 \
    https://github.com/GNOME/glib.git \
    /build/glib-src

WORKDIR /build/glib-src

# ============================================================
# GLib -> WebAssembly cross compilation file
# ============================================================

RUN cat > /build/glib-cross.txt <<'EOF'
[binaries]
c = 'emcc'
cpp = 'em++'
ar = 'emar'
strip = 'emstrip'
ranlib = 'emranlib'
pkgconfig = '/usr/bin/false'
python = 'python3'

[host_machine]
system = 'emscripten'
cpu_family = 'wasm32'
cpu = 'wasm32'
endian = 'little'

[properties]
needs_exe_wrapper = true
EOF

# ============================================================
# Download GLib subprojects
# ============================================================

RUN meson subprojects download

# ============================================================
# Show the libffi Meson file.
# This is useful if GLib configuration reaches libffi.
# ============================================================

RUN echo "========================================" && \
    echo " LIBFFI MESON.BUILD" && \
    echo "========================================" && \
    nl -ba /build/glib-src/subprojects/libffi/src/meson.build | head -120 && \
    echo "========================================"

# ============================================================
# Configure GLib
# ============================================================

RUN rm -rf /build/glib-build && \
    meson setup /build/glib-build \
      --cross-file /build/glib-cross.txt \
      --prefix=/build/sysroot \
      --libdir=lib \
      -Dtests=false \
      -Dinstalled_tests=false \
      -Dman=false \
      -Dbsymbolic_functions=false \
      -Dglib_debug=disabled \
      -Dforce_posix_threads=true

# ============================================================
# Build GLib
# ============================================================

RUN meson compile \
    -C /build/glib-build \
    -j2

# ============================================================
# Install GLib
# ============================================================

RUN meson install \
    -C /build/glib-build

# ============================================================
# Verify GLib installation
# ============================================================

RUN echo "========================================" && \
    echo " GLIB SYSROOT" && \
    echo "========================================" && \
    find /build/sysroot -maxdepth 3 -type f | head -150

# ============================================================
# QEMU
# ============================================================

WORKDIR /build

RUN git clone \
    --depth 1 \
    --branch v9.2.0 \
    https://gitlab.com/qemu-project/qemu.git \
    /build/qemu-src

WORKDIR /build/qemu-src

# ============================================================
# QEMU configuration
# ============================================================

RUN mkdir -p /build/qemu-build

RUN ./configure \
    --static \
    --target-list=x86_64-softmmu \
    --cpu=wasm32 \
    --disable-werror \
    --disable-docs \
    --disable-gtk \
    --disable-sdl \
    --disable-opengl \
    --disable-vte \
    --disable-curl \
    --disable-libssh \
    --disable-libnfs \
    --disable-libiscsi \
    --disable-bzip2 \
    --disable-lzo \
    --disable-snappy \
    --disable-zstd \
    --disable-seccomp \
    --disable-cap-ng \
    --disable-brlapi \
    --disable-libusb \
    --disable-usb-redir \
    --disable-spice \
    --disable-vnc-jpeg \
    --disable-vnc-png \
    --disable-vnc-sasl \
    --disable-xen \
    --disable-kvm \
    --disable-hvf \
    --disable-whpx \
    --disable-netmap \
    --disable-vde \
    --disable-virglrenderer \
    --disable-linux-aio \
    --disable-fdt \
    --disable-pie \
    --enable-tcg \
    --extra-cflags="-I/build/sysroot/include" \
    --extra-ldflags="-L/build/sysroot/lib"

# ============================================================
# Build QEMU-Wasm
# ============================================================

RUN emmake make -j2

# ============================================================
# Collect QEMU-Wasm output
# ============================================================

RUN mkdir -p /build/output/qemu && \
    find /build/qemu-build \
      -type f \
      \( \
        -name "*.js" \
        -o -name "*.wasm" \
        -o -name "*.worker.js" \
        -o -name "*.data" \
      \) \
      -exec cp -v {} /build/output/qemu/ \;

# ============================================================
# Final report
# ============================================================

RUN echo "" && \
    echo "======================================" && \
    echo " QEMU-WASM BUILD COMPLETE" && \
    echo "======================================" && \
    echo "" && \
    ls -lah /build/output/qemu
